# Copy to .env and change every value marked CHANGE.
DB_ROOT_PASSWORD=CHANGE-root-password
DB_PASSWORD=CHANGE-app-password
# 32+ random characters, e.g. generate with:  openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-0123456789abcdef

# Where the browser reaches the API and where the API accepts requests from
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000

# Development / demo defaults. For a real deployment set:
#   SEED_DEMO=false   AI_DEMO_ENDPOINT=false   SPRING_PROFILES_ACTIVE=prod
SEED_DEMO=true
AI_DEMO_ENDPOINT=true
SPRING_PROFILES_ACTIVE=

# ---- AI assistant (Spring AI + RAG) ----
# local = works with no account: answers from the policy notes and your live data
# llm   = a language model writes the answer (needs the settings below)
ASSISTANT_MODE=local
# Option A - OpenAI
#   ASSISTANT_MODE=llm  OPENAI_API_KEY=sk-...  (defaults: gpt-4o-mini, text-embedding-3-small)
# Option B - free local model with Ollama (ollama pull llama3.1 && ollama pull nomic-embed-text)
#   ASSISTANT_MODE=llm  OPENAI_API_KEY=ollama  LLM_BASE_URL=http://host.docker.internal:11434
#   LLM_CHAT_MODEL=llama3.1  LLM_EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=not-configured
LLM_BASE_URL=https://api.openai.com
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
